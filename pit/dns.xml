    <Agent name="PublisherAgent">
        <Monitor class="Process">
            <Param name="Executable" value="/usr/local/sbin/dnsmasq"/>
            <Param name="Arguments" value="-p 5353 -d -C /root/dnsmasq/dnsmasq.conf -8 /var/log/dnsmasq/dnsmasq.log"/>
            <Param name="RestartOnEachTest" value="false"/>
            <Param name="Faultonearlyexit" value="true"/>
        </Monitor>
    </Agent>
    <Test name="Default">
        <Agent ref="PublisherAgent" platform="linux"/>
        <StateModel ref="dns_StateModel"/>
        <Publisher class="Udp" name="client">
            <Param name="Host" value="127.0.0.1"/>
            <Param name="Port" value="5353"/>
        </Publisher>
        <Logger class="File">
            <Param name="Path" value="logs"/>
        </Logger>
